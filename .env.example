# Copy to .env and add your key. Never commit .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GENERATION_MODEL=gpt-4.1-mini
JUDGE_MODEL=gpt-4.1-mini

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=streamlit-genai-app
CAPTURE_CONTENT=false
OPENLIT_ENABLED=true
DEMO_GPU_SIMULATION=true
DEMO_WORKLOAD_INTERVAL_SECONDS=1
EVAL_SAMPLE_RATE=1.0
EVAL_RUBRIC_VERSION=v1
REDIS_URL=redis://redis:6379/0

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
