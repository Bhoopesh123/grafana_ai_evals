{
  "annotations": {"list": []},
  "description": "Unfiltered quality and safety overview across all ten GenAI evaluation pillars.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Answers evaluated",
      "description": "Unique evaluation runs approximated from per-pillar results.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(increase(genai_eval_runs_total{status=\"ok\"}[6h])) / 10", "instant": true}],
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "blue"}, "decimals": 0, "unit": "short"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Overall pass rate",
      "description": "Pass rate across every applicable pillar.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(increase(genai_eval_runs_total{status=\"ok\",applicable=\"true\",pass=\"true\"}[6h])) / clamp_min(sum(increase(genai_eval_runs_total{status=\"ok\",applicable=\"true\"}[6h])), 1)", "instant": true}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "decimals": 1, "min": 0, "max": 1, "unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0.75}, {"color": "green", "value": 0.9}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "gridPos": {"h": 5, "w": 4, "x": 4, "y": 0}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Average quality score",
      "description": "Mean score across all applicable pillars.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(increase(genai_eval_score_sum[6h])) / clamp_min(sum(increase(genai_eval_score_count[6h])), 1)", "instant": true}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "decimals": 2, "min": 0, "max": 1, "unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "green", "value": 0.85}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "gridPos": {"h": 5, "w": 4, "x": 8, "y": 0}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Failed pillar checks",
      "description": "Applicable pillar verdicts that did not pass.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(increase(genai_eval_runs_total{status=\"ok\",applicable=\"true\",pass=\"false\"}[6h]))", "instant": true}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "decimals": 0, "unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 5}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "gridPos": {"h": 5, "w": 4, "x": 12, "y": 0}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Evaluation errors",
      "description": "Judge or schema failures across the pipeline.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(increase(genai_eval_runs_total{status=\"error\"}[6h])) / 10", "instant": true}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "decimals": 0, "unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "gridPos": {"h": 5, "w": 4, "x": 16, "y": 0}
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Generation requests",
      "description": "OpenAI answer-generation traffic in the selected time range.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(increase(genai_requests_total[6h]))", "instant": true}],
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "purple"}, "decimals": 0, "unit": "short"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "gridPos": {"h": 5, "w": 4, "x": 20, "y": 0}
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Quality score by pillar — all pillars",
      "description": "Average score for every applicable quality and safety pillar. Higher is better.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (eval_pillar) (increase(genai_eval_score_sum[6h])) / clamp_min(sum by (eval_pillar) (increase(genai_eval_score_count[6h])), 1)", "instant": true, "legendFormat": "{{eval_pillar}}"}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "decimals": 2, "min": 0, "max": 1, "unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0.7}, {"color": "yellow", "value": 0.8}, {"color": "green", "value": 0.9}]}}, "overrides": []},
      "options": {"displayMode": "gradient", "legend": {"displayMode": "hidden", "placement": "bottom", "showLegend": false}, "minVizHeight": 16, "minVizWidth": 8, "namePlacement": "left", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showUnfilled": true, "sizing": "auto", "valueMode": "color"},
      "gridPos": {"h": 12, "w": 12, "x": 0, "y": 5}
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Pass rate by pillar — all pillars",
      "description": "Passed checks divided by all applicable checks for each pillar.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (eval_pillar) (increase(genai_eval_runs_total{status=\"ok\",applicable=\"true\",pass=\"true\"}[6h])) / clamp_min(sum by (eval_pillar) (increase(genai_eval_runs_total{status=\"ok\",applicable=\"true\"}[6h])), 1)", "instant": true, "legendFormat": "{{eval_pillar}}"}],
      "fieldConfig": {"defaults": {"color": {"mode": "continuous-GrYlRd"}, "decimals": 1, "min": 0, "max": 1, "unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0.75}, {"color": "green", "value": 0.9}]}}, "overrides": []},
      "options": {"displayMode": "gradient", "legend": {"displayMode": "hidden", "placement": "bottom", "showLegend": false}, "minVizHeight": 16, "minVizWidth": 8, "namePlacement": "left", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showUnfilled": true, "sizing": "auto", "valueMode": "color"},
      "gridPos": {"h": 12, "w": 12, "x": 12, "y": 5}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Score trend by pillar",
      "description": "Five-minute rolling average score with all pillars visible together.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (eval_pillar) (rate(genai_eval_score_sum[5m])) / clamp_min(sum by (eval_pillar) (rate(genai_eval_score_count[5m])), 0.000001)", "legendFormat": "{{eval_pillar}}"}],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "Score", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 12, "gradientMode": "opacity", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "auto", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}}, "decimals": 2, "min": 0, "max": 1, "unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.8}]}}, "overrides": []},
      "options": {"legend": {"calcs": ["mean", "lastNotNull"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 11, "w": 16, "x": 0, "y": 17}
    },
    {
      "id": 10,
      "type": "piechart",
      "title": "Evaluation verdicts",
      "description": "Distribution of pass, fail, and not-applicable verdicts.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (pass) (increase(genai_eval_runs_total{status=\"ok\"}[6h]))", "instant": true, "legendFormat": "{{pass}}"}],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "short"}, "overrides": [{"matcher": {"id": "byName", "options": "true"}, "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]}, {"matcher": {"id": "byName", "options": "false"}, "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]}, {"matcher": {"id": "byName", "options": "not_applicable"}, "properties": [{"id": "color", "value": {"fixedColor": "gray", "mode": "fixed"}}]}]},
      "options": {"displayLabels": ["name", "percent"], "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "values": ["value", "percent"]}, "pieType": "donut", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": true}, "tooltip": {"hideZeros": false, "mode": "single", "sort": "none"}},
      "gridPos": {"h": 11, "w": 8, "x": 16, "y": 17}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Generation latency p50 / p95",
      "description": "End-user answer generation latency.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(genai_request_duration_seconds_bucket[5m])))", "legendFormat": "p50"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(genai_request_duration_seconds_bucket[5m])))", "legendFormat": "p95"}],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 18, "gradientMode": "opacity", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}}, "unit": "s"}, "overrides": []},
      "options": {"legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 9, "w": 8, "x": 0, "y": 28}
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Judge latency p50 / p95",
      "description": "Latency of the complete ten-pillar judge call.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(genai_eval_duration_seconds_bucket[5m])))", "legendFormat": "p50"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(genai_eval_duration_seconds_bucket[5m])))", "legendFormat": "p95"}],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 18, "gradientMode": "opacity", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}}, "unit": "s"}, "overrides": []},
      "options": {"legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 9, "w": 8, "x": 8, "y": 28}
    },
    {
      "id": 13,
      "type": "bargauge",
      "title": "Checks performed by pillar",
      "description": "Evaluation coverage, including applicable and non-applicable checks.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (eval_pillar) (increase(genai_eval_runs_total{status=\"ok\"}[6h]))", "instant": true, "legendFormat": "{{eval_pillar}}"}],
      "fieldConfig": {"defaults": {"color": {"mode": "continuous-BlPu"}, "decimals": 0, "unit": "short"}, "overrides": []},
      "options": {"displayMode": "gradient", "legend": {"displayMode": "hidden", "placement": "bottom", "showLegend": false}, "minVizHeight": 16, "minVizWidth": 8, "namePlacement": "left", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showUnfilled": true, "sizing": "auto", "valueMode": "color"},
      "gridPos": {"h": 9, "w": 8, "x": 16, "y": 28}
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": ["genai", "evaluation", "openai", "quality", "safety"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "GenAI Evaluation — All 10 Pillars",
